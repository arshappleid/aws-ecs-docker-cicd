{
	"family": "<PROJECT_NAME>-backend-task-definition",
	"taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/<PROJECT_NAME>-backend-ecs-task-role",
	"executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/<PROJECT_NAME>-backend-ecs-task-execution-role",
	"networkMode": "bridge",
	"requiresCompatibilities": ["EC2"],
	"cpu": "1024",
	"memory": "1024",
	"runtimePlatform": {
		"cpuArchitecture": "X86_64",
		"operatingSystemFamily": "LINUX"
	},
	"volumes": [],
	"placementConstraints": [],
	"containerDefinitions": [
		{
			"name": "backend-api",
			"image": "<AWS_ACCOUNT_ID>.dkr.ecr.<AWS_REGION>.amazonaws.com/<ECR_REPO_NAME>:<IMAGE_TAG>",
			"cpu": 1024,
			"memory": 1024,
			"portMappings": [
				{
					"name": "backend-api-80-tcp",
					"containerPort": 80,
					"hostPort": 0,
					"protocol": "tcp"
				}
			],
			"essential": true,
			"environment": [
				{
					"name": "ENVIRONMENT",
					"value": "prod"
				},
				{
					"name": "AWS_REGION",
					"value": "us-east-1"
				}
			],
			"mountPoints": [],
			"volumesFrom": [],
			"readonlyRootFilesystem": false,
			"logConfiguration": {
				"logDriver": "json-file",
				"options": {
					"max-size": "50m",
					"max-file": "5"
				}
			},
			"healthCheck": {
				"command": [
					"CMD-SHELL",
					"python3 -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:80/health\")' || exit 1"
				],
				"interval": 30,
				"timeout": 5,
				"retries": 3,
				"startPeriod": 120
			},
			"systemControls": []
		}
	]
}
