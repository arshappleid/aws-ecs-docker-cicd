{
	"family": "prab-cicd-ecs-backend-dev",
	"taskRoleArn": "arn:aws:iam::866934333672:role/prab-cicd-backend-task-role",
	"executionRoleArn": "arn:aws:iam::866934333672:role/prab-cicd-backend-task-execution-role",
	"networkMode": "awsvpc",
	"requiresCompatibilities": ["FARGATE"],
	"cpu": "1024",
	"memory": "2048",
	"runtimePlatform": {
		"cpuArchitecture": "X86_64",
		"operatingSystemFamily": "LINUX"
	},
	"volumes": [],
	"placementConstraints": [],
	"containerDefinitions": [
		{
			"name": "flask-api",
			"image": "866934333672.dkr.ecr.us-east-1.amazonaws.com/prab-cicd-backend:latest",
			"cpu": 1024,
			"memory": 2048,
			"portMappings": [
				{
					"name": "backend-api-80-tcp",
					"containerPort": 80,
					"hostPort": 80,
					"protocol": "tcp"
				}
			],
			"essential": true,
			"environment": [
				{
					"name": "ENVIRONMENT",
					"value": "dev"
				},
				{
					"name": "AWS_REGION",
					"value": "us-east-1"
				}
			],
			"mountPoints": [],
			"volumesFrom": [],
			"readonlyRootFilesystem": false,
			"logConfiguration": {
				"logDriver": "awslogs",
				"options": {
					"awslogs-group": "/ecs/dev/prab-cicd-backend",
					"awslogs-create-group": "true",
					"awslogs-region": "us-east-1",
					"awslogs-stream-prefix": "ecs-backend-dev"
				}
			},
			"healthCheck": {
				"command": [
					"CMD-SHELL",
					"python3 -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:80/health\")' || exit 1"
				],
				"interval": 30,
				"timeout": 5,
				"retries": 3,
				"startPeriod": 120
			},
			"systemControls": []
		}
	]
}
