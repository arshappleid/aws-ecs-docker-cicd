{
    "family": "prab-cicd-ecs-backend-dev",
    "taskRoleArn": "arn:aws:iam::866934333672:role/prab-cicd-backend-task-role",
    "executionRoleArn": "arn:aws:iam::866934333672:role/prab-cicd-backend-task-execution-role",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "volumes": [],
    "placementConstraints": [],
    "containerDefinitions": [
        {
            "name": "flask-api",
            "image": "866934333672.dkr.ecr.us-east-1.amazonaws.com/prab-cicd-backend:latest",
            "cpu": 768,
            "memory": 1536,
            "portMappings": [
                {
                    "name": "backend-api-80-tcp",
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "essential": true,
            "dependsOn": [
                {
                    "containerName": "splunk-otel-collector",
                    "condition": "START"
                }
            ],
            "environment": [
                {
                    "name": "ENVIRONMENT",
                    "value": "dev"
                },
                {
                    "name": "AWS_REGION",
                    "value": "us-east-1"
                },
				{
                     "name": "SPLUNK_REALM",
                     "value": "us0"
                },
				{
					"name": "OTEL_EXPORTER_OTLP_ENDPOINT",
					"value": "http://localhost:4317"
				 }
            ],
            "mountPoints": [],
            "volumesFrom": [],
            "readonlyRootFilesystem": false,
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/dev/prab-cicd-backend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-backend-dev"
                }
            },
            "healthCheck": {
                "command": [
                    "CMD-SHELL",
                    "python3 -c 'import urllib.request; urllib.request.urlopen(\"http://localhost:80/health\")' || exit 1"
                ],
                "interval": 30,
                "timeout": 5,
                "retries": 3,
                "startPeriod": 120
            },
            "systemControls": []
        },
        {
            "name": "splunk-otel-collector",
            "image": "quay.io/signalfx/splunk-otel-collector:latest",
            "cpu": 256,
            "memory": 512,
            "essential": true,
            "portMappings": [
                {
                    "name": "otel-grpc-4317",
                    "containerPort": 4317,
                    "hostPort": 4317,
                    "protocol": "tcp"
                },
                {
                    "name": "otel-http-4318",
                    "containerPort": 4318,
                    "hostPort": 4318,
                    "protocol": "tcp"
                }
            ],
            "environment": [
    {
        "name": "SPLUNK_HEC_URL",
        "value": "https://prd-p-ykpou.splunkcloud.com:8088/v1/collector"
    },
    {
        "name": "SPLUNK_CONFIG",
        "value": "/etc/otel/collector/gateway_config.yaml"
    }
],
            "secrets": [
                {
                    "name": "SPLUNK_ACCESS_TOKEN",
                    "valueFrom": "arn:aws:ssm:us-east-1:866934333672:parameter/prab/aws-ecs-cicd/splunk/access_token"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/dev/prab-cicd-backend",
                    "awslogs-create-group": "true",
                    "awslogs-region": "us-east-1",
                    "awslogs-stream-prefix": "ecs-splunk-sidecar"
                }
            }
        }
    ]
}